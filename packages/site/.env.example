# Stellar Snap site: build settings. Copy this file to .env (git ignores it) and fill what you need.
# Everything is optional. VITE_ variables end up in the public site: never put a secret in one.

# Public address of the site, for canonical URLs, hreflang, the sitemap and social cards.
# Detected on Vercel, Netlify, Cloudflare Pages and Render; set it for any other host.
# Example: VITE_SITE_URL=https://stellarsnap.example.com
VITE_SITE_URL=

# Folder the site is served from when it isn't a domain's root, e.g. /Stellar-Snap for the GitHub
# Pages fallback (website.yml sets it). Leave it empty for a domain of its own.
BASE_PATH=

# Snap that "Install in MetaMask" installs. Default: the local snap server during `npm run dev`,
# npm:@cosmosapp/stellar-snap in a build.
VITE_SNAP_ID=

# Donations section on the home page: a Stellar account (G…) on the public network, and/or a page
# with other ways to give (GitHub Sponsors, Open Collective…). With neither, the section is hidden.
VITE_DONATION_ADDRESS=
VITE_DONATION_URL=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). It loads only after the visitor accepts the
# notice, and the privacy policy then describes it.
VITE_GA_MEASUREMENT_ID=

# Search engine ownership tags: only the `content` value each console gives you.
# Not needed when a domain property verified by DNS already covers the site (Bing can import it from Google).
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
VITE_YANDEX_VERIFICATION=
VITE_BAIDU_SITE_VERIFICATION=
VITE_NAVER_SITE_VERIFICATION=
VITE_SEZNAM_VERIFICATION=

# IndexNow key (8 to 128 letters, digits or dashes; not secret). The build publishes /<key>.txt, and
# `npm run indexnow -w packages/site` announces every page to Bing, Yandex, Naver and Seznam after a deploy.
INDEXNOW_KEY=
