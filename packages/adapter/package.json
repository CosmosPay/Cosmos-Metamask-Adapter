{
  "name": "@cosmospay/stellar-metamask-adapter",
  "version": "0.1.0",
  "description": "SEP-43 adapter that lets Stellar/Soroban dApps use MetaMask: official MetaMask Stellar support on mainnet, Stellar Snap on testnet/futurenet",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@metamask/connect-stellar": "^0.3.0"
  },
  "peerDependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.7.0"
  },
  "peerDependenciesMeta": {
    "@creit.tech/stellar-wallets-kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.7.0",
    "typescript": "^7.0.2",
    "@types/node": "^26.6.4"
  }
}
