{
  "name": "@cosmospay/stellar-metamask-adapter",
  "version": "0.1.0",
  "description": "SEP-43 adapter that lets Stellar/Soroban dApps use MetaMask: official MetaMask Stellar support on mainnet, Stellar Snap on testnet/futurenet",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning ../../node_modules/jest/bin/jest.js",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@metamask/connect-stellar": "^0.3.0"
  },
  "peerDependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.7.0"
  },
  "peerDependenciesMeta": {
    "@creit.tech/stellar-wallets-kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.7.0",
    "@swc/core": "^1.11.31",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "jest": "^30.5.2",
    "tsc-alias": "^1.9.7",
    "typescript": "^7.0.2"
  }
}
