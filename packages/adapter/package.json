{
  "name": "@cosmosapp/stellar-metamask-adapter",
  "version": "0.1.0",
  "description": "SEP-43 adapter that lets Stellar/Soroban dApps use MetaMask: official MetaMask Stellar support on mainnet, Stellar Snap on testnet/futurenet",
  "keywords": [
    "stellar",
    "soroban",
    "metamask",
    "sep-43",
    "freighter",
    "stellar-wallets-kit",
    "wallet",
    "dapp",
    "web3"
  ],
  "homepage": "https://github.com/CosmosPay/Cosmos-Metamask-Adapter#readme",
  "bugs": {
    "url": "https://github.com/CosmosPay/Cosmos-Metamask-Adapter/issues",
    "email": "contact@cosmospay.lat"
  },
  "author": "Cosmos Pay <contact@cosmospay.lat> (https://cosmospay.lat)",
  "repository": {
    "type": "git",
    "url": "https://github.com/CosmosPay/Cosmos-Metamask-Adapter.git",
    "directory": "packages/adapter"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning ../../node_modules/jest/bin/jest.js",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@metamask/connect-stellar": "^0.3.0"
  },
  "peerDependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.7.0"
  },
  "peerDependenciesMeta": {
    "@creit.tech/stellar-wallets-kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.7.0",
    "@swc/core": "^1.11.31",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "jest": "^30.5.2",
    "tsc-alias": "^1.9.7",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
