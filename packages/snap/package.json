{
  "name": "@cosmosapp/stellar-snap",
  "version": "0.2.0",
  "description": "MetaMask Snap that adds native Stellar accounts, signing and payments to MetaMask",
  "keywords": [
    "metamask",
    "snap",
    "metamask-snap",
    "stellar",
    "soroban",
    "xlm",
    "wallet",
    "sep-43",
    "web3"
  ],
  "homepage": "https://github.com/CosmosPay/Stellar-Snap#readme",
  "bugs": {
    "url": "https://github.com/CosmosPay/Stellar-Snap/issues",
    "email": "contact@cosmospay.lat"
  },
  "author": "Cosmos Pay <contact@cosmospay.lat> (https://cosmospay.lat)",
  "license": "MIT",
  "main": "./dist/bundle.js",
  "files": [
    "dist/",
    "images/",
    "snap.manifest.json",
    "locales/",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "mm-snap build",
    "start": "mm-snap watch",
    "test": "mm-snap build && node --experimental-vm-modules --no-warnings=ExperimentalWarning ../../node_modules/jest/bin/jest.js",
    "test:live": "mm-snap build && node scripts/test-live.mts",
    "typecheck": "tsc --noEmit -p .",
    "test:unit": "node --experimental-vm-modules --no-warnings=ExperimentalWarning ../../node_modules/jest/bin/jest.js --selectProjects unit",
    "test:integration": "mm-snap build && node --experimental-vm-modules --no-warnings=ExperimentalWarning ../../node_modules/jest/bin/jest.js --selectProjects integration",
    "sync:registry": "node scripts/sync-registry.mts"
  },
  "dependencies": {
    "@metamask/key-tree": "^10.1.1",
    "@metamask/scure-bip39": "^2.1.1",
    "@metamask/snaps-sdk": "~12.0.1",
    "@metamask/superstruct": "^3.4.1",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@stellar/stellar-sdk": "^17.2.1",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@metamask/snaps-cli": "^8.4.1",
    "@metamask/snaps-jest": "^10.2.1",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "ethers": "^6.17.0",
    "jest": "^30.5.2",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CosmosPay/Stellar-Snap.git",
    "directory": "packages/snap"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=24"
  }
}
