# Stellar Snap (the MetaMask Snap): build settings. Copy this file to .env (git ignores it).
#
# Optional Cosmos Pay API keys, one per ledger: a `dev` key works only on testnet and a `prod` key
# only on mainnet. Without them the snap fetches Cosmos Pay's shared public key at runtime.
# They're built into the snap's code, which anyone can read: use keys meant to be public.
COSMOS_API_KEY_TESTNET=
COSMOS_API_KEY_MAINNET=
