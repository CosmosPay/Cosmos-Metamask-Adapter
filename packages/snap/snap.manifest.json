{
  "version": "0.2.0",
  "description": "{{manifest.description}}",
  "proposedName": "Stellar Snap",
  "repository": {
    "type": "git",
    "url": "https://github.com/CosmosPay/Cosmos-Metamask-Adapter.git"
  },
  "source": {
    "shasum": "gq6276ksJ/Js74SdfWBw7XGzRZu5m7L/pzu3G4fslyc=",
    "location": {
      "npm": {
        "filePath": "dist/bundle.js",
        "iconPath": "images/icon.svg",
        "packageName": "@cosmosapp/stellar-snap",
        "registry": "https://registry.npmjs.org/"
      }
    },
    "locales": ["locales/en.json", "locales/es.json", "locales/pt.json"]
  },
  "initialPermissions": {
    "endowment:rpc": {
      "dapps": true,
      "snaps": false
    },
    "endowment:network-access": {},
    "endowment:page-home": {},
    "snap_dialog": {},
    "snap_getBip32Entropy": [
      {
        "path": ["m", "44'", "148'"],
        "curve": "ed25519"
      }
    ],
    "snap_manageState": {},
    "snap_getPreferences": {}
  },
  "platformVersion": "12.0.1",
  "manifestVersion": "0.1"
}
