{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@metamask/snaps-sdk",
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@locales/*": ["./locales/*"],
      "@test/*": ["./test/*"]
    }
  },
  "include": ["src", "test", "scripts", "snap.config.ts", "jest.config.ts"]
}
